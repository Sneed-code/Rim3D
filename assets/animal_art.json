    {"model": "Elephant", "credit": "AFRICAN ANIMALS PACK by Protofactor, free on Fab", "assets": {"mesh": "/Game/AfricanAnimalsPack/Elephant/Meshes/SK_Elephant", "Idle": "/Game/AfricanAnimalsPack/Elephant/Animations/ANIM_Elephant_IdleBreathe", "Walk": "/Game/AfricanAnimalsPack/Elephant/Animations/ANIM_Elephant_Walk", "Gallop": "/Game/AfricanAnimalsPack/Elephant/Animations/ANIM_Elephant_Run", "Eating": "/Game/AfricanAnimalsPack/Elephant/Animations/ANIM_Elephant_IdleLookAroundEat", "Death": "/Game/AfricanAnimalsPack/Elephant/Animations/ANIM_Elephant_Death"}, "yaw": -90, "walkCm": 150, "gallopCm": 450, "parts": ["/Game/AfricanAnimalsPack/Elephant/Meshes/SK_ElephantTusksMedium"]},
