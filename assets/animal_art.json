    {"model": "Chimpanzee", "file": "assets/raw/sketchfab/male-chimpanzee-hairless-rigged-animated/source/male_chimp_v5_Sketchfab.glb", "credit": "Male Chimpanzee by Animal Animator, CC BY", "clips": {"Idle": "01_Idle", "Walk": "02_KnuckleWalk", "Gallop": "03_Gallop"}, "yaw": -90, "walkCm": 90, "gallopCm": 300},
    {"model": "SphynxCat", "file": "assets/raw/sketchfab/sphynx-cat-rigged-animated-10-anims/source/Sphinx_Cat_Animated_v9.glb", "credit": "Sphynx Cat by Animal Animator, CC BY", "clips": {"Idle": "Cat_Idle", "Walk": "Cat_Walk", "Gallop": "Cat_Gallop_Run", "Eating": "Cat_Lick_Paw"}, "yaw": -90, "walkCm": 70, "gallopCm": 250},
    {"model": "Hyena", "file": "assets/raw/sketchfab/elder-spotted-hyena-crocuta-sculpted-furry/source/Spotted_Hyena_Elder_Matriarch_Fur_Rigged_Animated_v5.glb", "credit": "Elder Spotted Hyena by Animal Animator, CC BY", "clips": {"Idle": "01_Idle_Breathing_Scanning", "Walk": "02_Walk_LateralSequence", "Gallop": "03_Run_TransverseGallop", "Eating": "04_Eat_Tear_Chew_BoneCrack"}, "yaw": -90, "walkCm": 130, "gallopCm": 450},
