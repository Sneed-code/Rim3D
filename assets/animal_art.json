    {"model": "Lioness", "credit": "AFRICAN ANIMALS PACK by Protofactor, free on Fab", "assets": {"mesh": "/Game/AfricanAnimalsPack/LionAndLioness/Meshes/SK_Lioness_LOD0", "Idle": "/Game/AfricanAnimalsPack/LionAndLioness/Animations/ANIM_Lion_IdleBreathe", "Walk": "/Game/AfricanAnimalsPack/LionAndLioness/Animations/ANIM_Lion_Walk", "Gallop": "/Game/AfricanAnimalsPack/LionAndLioness/Animations/ANIM_Lion_Run", "Death": "/Game/AfricanAnimalsPack/LionAndLioness/Animations/ANIM_Lion_Death"}, "yaw": -90, "walkCm": 120, "gallopCm": 700},
