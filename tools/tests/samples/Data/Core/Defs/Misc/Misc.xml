    <defName>Industriousness</defName>
    <commonality>1</commonality>
    <degreeDatas>
      <li>
        <label>industrious</label>
        <degree>1</degree>
        <description>Prose.</description>
        <statOffsets><WorkSpeedGlobal>0.35</WorkSpeedGlobal></statOffsets>
