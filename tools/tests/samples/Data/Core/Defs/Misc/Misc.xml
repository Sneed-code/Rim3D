      <li>
        <label>ate without table</label>
        <description>Prose that must not be copied.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>Hungry</defName>
    <workerClass>ThoughtWorker_Hunger</workerClass>
